{
  "name": "chess-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:fetch": "node scripts/fetch-engine.mjs",
    "engine:smoke": "node scripts/engine-smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "postinstall": "node scripts/fetch-engine.mjs",
    "build:apple": "swift build --package-path bridge-apple -c release && mkdir -p bridge-apple/.bin && cp bridge-apple/.build/release/chesscoach-apple-llm bridge-apple/.bin/"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.1.1",
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
